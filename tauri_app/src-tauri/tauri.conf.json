{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Claim",
  "version": "0.1.0",
  "identifier": "com.fifi.tauri-app",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AI Claim",
        "width": 1200,
        "height": 800,
        "url": "http://localhost:8001/welcome",
        "alwaysOnTop": true,
        "resizable": true,
        "userAgent": "AIClaim-Doctor"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
